# ---- copy เป็น .env แล้วแก้ค่า (อย่า commit ไฟล์ .env ขึ้น git) ----

# production = ปิด /docs และบังคับต้องมี JWT_SECRET
APP_ENV=development

# ใช้ user จาก 03_app_user.sql - ไม่ใช้ root
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=onlyfood
DB_USER=onlyfood_app
DB_PASSWORD=

# สร้างด้วย: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=480

# โดเมนของ frontend คั่นด้วย , (ห้ามใช้ *)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# OAuth Client ID จาก Google Cloud Console (เว้นว่าง = ปิด Google Sign-In)
GOOGLE_CLIENT_ID=

FOOD_COURT_ID=1
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
