# คัดลอกเป็น .env แล้วแก้ค่าทุกบรรทัด (ห้าม commit .env)

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=เปลี่ยนเป็นรหัสผ่านยาว ๆ
MYSQL_USER=onlyfood_app
MYSQL_PASSWORD=เปลี่ยนเป็นรหัสผ่านยาว ๆ อีกชุด

# ---- Backend ----
# ยาวอย่างน้อย 32 ตัวอักษร สร้างด้วย:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# ใช้เมื่อเปิด Google Login (ค่าเดียวกับ VITE_GOOGLE_CLIENT_ID ใน frontend/.env) เว้นว่าง = ปิด Google Login
GOOGLE_CLIENT_ID=
# ปกติเว้นว่าง (หน้าเว็บกับ API อยู่ origin เดียวกันผ่าน nginx) ; ใส่เฉพาะตอนพัฒนา เช่น http://localhost:5173
CORS_ORIGINS=
# 1 = ปิดหน้า /api/docs
DISABLE_DOCS=0

# ---- nginx ----
# ./nginx.conf (HTTPS) หรือ ./nginx.http-only.conf (ชั่วคราวถ้ายังไม่มีใบรับรอง)
NGINX_CONF=./nginx.conf
